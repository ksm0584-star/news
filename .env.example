# Mixpanel (client-side analytics token — safe to expose in the browser)
NEXT_PUBLIC_MIXPANEL_TOKEN=

# Supabase (client-safe: URL + anon key are protected by Row Level Security,
# not by secrecy — never put the service_role key in a NEXT_PUBLIC_* var)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (no NEXT_PUBLIC_ prefix — never sent to the browser). Required
# for POST /api/account/delete (마이페이지 회원 탈퇴) to actually delete the
# Supabase Auth user. Find it in Supabase Dashboard > Project Settings >
# API > service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only (no NEXT_PUBLIC_ prefix — never sent to the browser). Required
# for POST /api/economic-term (경제용어사전) to call Gemini. Get a key at
# https://aistudio.google.com/apikey (free tier available).
GEMINI_API_KEY=
