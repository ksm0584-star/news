# Mixpanel (client-side analytics token — safe to expose in the browser)
NEXT_PUBLIC_MIXPANEL_TOKEN=

# Supabase (client-safe: URL + anon key are protected by Row Level Security,
# not by secrecy — never put the service_role key in a NEXT_PUBLIC_* var)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
