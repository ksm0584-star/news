# Mixpanel (client-side analytics token — safe to expose in the browser)
NEXT_PUBLIC_MIXPANEL_TOKEN=

# Amplitude (client-side analytics API key — safe to expose in the browser)
NEXT_PUBLIC_AMPLITUDE_API_KEY=

# Supabase (client-safe: URL + anon key are protected by Row Level Security,
# not by secrecy — never put the service_role key in a NEXT_PUBLIC_* var)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (no NEXT_PUBLIC_ prefix — never sent to the browser). Required
# for POST /api/account/delete (마이페이지 회원 탈퇴) to actually delete the
# Supabase Auth user. Find it in Supabase Dashboard > Project Settings >
# API > service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only (no NEXT_PUBLIC_ prefix — never sent to the browser). Required
# for POST /api/economic-term (경제용어사전) to call Gemini. Get a key at
# https://aistudio.google.com/apikey (free tier available).
GEMINI_API_KEY=

# Server-only (no NEXT_PUBLIC_ prefix — never sent to the browser). Guards
# GET /api/cron/hot-news (지금 주목할 뉴스의 매일 08:00 KST 자동 갱신) against
# being triggered by anyone other than Vercel's own cron scheduler (see
# vercel.json) — Vercel automatically sends this value as an
# `Authorization: Bearer <value>` header when it invokes a cron job, which
# the route compares against this env var. Generate your own random string
# (16+ characters) and set the SAME value in Vercel's Project Settings >
# Environment Variables — it's not a third-party credential, just a shared
# secret between this app and Vercel's scheduler, so nothing to apply for.
CRON_SECRET=
